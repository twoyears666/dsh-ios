#!/bin/sh
# dsh-ctl —— 内核控制（启动 / 停止 / 重启 / 状态 / 保活开关）
#
# 用法：
#   dsh-ctl status      查看状态
#   dsh-ctl start       启动内核
#   dsh-ctl stop        停止内核（并关掉保活，防止被拉起）
#   dsh-ctl clear       强制清除内核进程（关保活 + 杀进程 + 等端口释放）
#   dsh-ctl ps          看内核进程（pidfile / 端口 / launchd，有 ps 就列全表）
#   dsh-ctl restart     重启内核
#   dsh-ctl enable      开启保活（开机自启 + 崩溃自动拉起）
#   dsh-ctl disable     关闭保活（不阻止手动启动）
#
# 保活状态由 launchd 的 disabled 覆盖标记决定：
#   /var/jb/var/db/launchd.db 里 com.twoyears.dsh 的 Disabled 字段
# 这里用 launchctl enable/disable + 文件标记双重记录，避免状态漂移。

set -u

JB=/var/jb
D="$JB/usr/lib/dsh"
ROOT=/var/mobile/Media/deepseek-harness
LABEL=com.twoyears.dsh
PLIST="$JB/Library/LaunchDaemons/$LABEL.plist"
FLAG="$ROOT/config/keepalive.disabled"
PIDFILE="$ROOT/config/kernel.pid"
LOG="$ROOT/logs/ctl.log"

# 只认「我们这个移植版」的内核 argv，不碰设备上别的 dsh。
# 设备上可能同时装着 npm 全局的 dsh、别的越狱包带的 dsh，
# 用 'dsh/lib/bin.js' 这种宽模式会把它们一起杀掉。
# 我们的内核 argv 一定含下面这个绝对路径：
#   launcher 里 BIN=$D/node_modules/@deepseek-ai/dsh/lib/bin.js
#   $D 固定 /var/jb/usr/lib/dsh（即便经 preboot 路径调用也不变）
KERNEL_ARGV="$D/node_modules/@deepseek-ai/dsh/lib/bin.js"
LAUNCHER_ARGV="$JB/usr/bin/dsh web"

mkdir -p "$(dirname "$FLAG")" "$ROOT/logs" 2>/dev/null || true

say() { printf '%s\n' "$*"; }
logline() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null || true; }

port() {
    # 从 dsh.env 读端口，默认 3080
    p=""
    [ -f "$JB/etc/dsh/dsh.env" ] && p=$(sed -n 's/.*DSH_WEB_PORT:=\([0-9]*\).*/\1/p' "$JB/etc/dsh/dsh.env" | head -1)
    printf '%s' "${p:-3080}"
}

is_running() {
    # 端口能连上就算在跑（不依赖 launchd 内部状态）
    nc -z 127.0.0.1 "$(port)" 2>/dev/null
}

launchd_loaded() {
    launchctl print "system/$LABEL" >/dev/null 2>&1
}

cmd_status() {
    P=$(port)
    say "=== dsh 状态 ==="
    if is_running; then
        say "  内核:    运行中（端口 $P）"
    else
        say "  内核:    未运行"
    fi

    if [ -f "$FLAG" ]; then
        say "  保活:    已关闭（不会被自动拉起）"
    else
        say "  保活:    已开启（开机自启 + 崩溃自动拉起）"
    fi

    if launchd_loaded; then
        say "  launchd: 已注册"
    else
        say "  launchd: 未注册"
    fi

    if [ -f "$ROOT/logs/web.log" ]; then
        U=$(grep -o "http://[0-9.]*:[0-9]*/?token=[A-Za-z0-9_-]*" "$ROOT/logs/web.log" 2>/dev/null | tail -1)
        [ -n "$U" ] && say "  URL:     $U"
    fi

    # 版本：装的是什么 + 日志最后写入时间。
    # 两者对不上就说明跑着的还是旧内核（日志没被新进程重写过）。
    if [ -f "$D/VERSION" ]; then
        say "  版本:    $(sed -n '1p' "$D/VERSION" 2>/dev/null)"
    fi
    if [ -f "$ROOT/logs/web.log" ]; then
        say "  日志:    $(date -r "$ROOT/logs/web.log" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
    fi

    # App 自己的启动记录。外壳每次启动都会写一行
    #   === App 启动 外壳 X 内核 Y ===
    # 「版本」和这行里的内核号对不上，就是外壳和 deb 不同步。
    if [ -f "$ROOT/logs/app.log" ]; then
        _a=$(grep -o 'App 启动.*' "$ROOT/logs/app.log" 2>/dev/null | tail -1)
        [ -n "$_a" ] && say "  外壳:    $_a"
    fi
    return 0
}

# 查进程。
#
# 设备上默认没有 ps / pgrep / procps，所以这里只能：
#   1) 读 pidfile 判断内核活着没（launcher 写入，最准）
#   2) nc -z 探端口（看有没有别的东西占着）
#   3) 查 launchd 注册状态
# 有 ps 就顺手列一遍，没有就提示用户去 App 里看原生枚举。
cmd_ps() {
    say "=== dsh 进程 ==="

    if [ -f "$PIDFILE" ]; then
        _p=$(sed -n '1p' "$PIDFILE" 2>/dev/null)
        case "$_p" in
            ''|*[!0-9]*)
                say "  内核:    pidfile 内容无效（$_p）"
                ;;
            *)
                if kill -0 "$_p" 2>/dev/null; then
                    say "  内核:    运行中（pid $_p）"
                else
                    say "  内核:    已退出（pid $_p 是旧记录）"
                fi
                ;;
        esac
    else
        say "  内核:    没有 pidfile"
    fi

    if is_running; then
        say "  端口:    $(port) 在监听"
    else
        say "  端口:    $(port) 未监听"
    fi

    if launchd_loaded; then
        say "  launchd: 已注册"
    else
        say "  launchd: 未注册"
    fi

    if command -v ps >/dev/null 2>&1; then
        say ""
        say "=== 系统进程（过滤 dsh / node）==="
        ps -A 2>/dev/null | grep -E 'dsh|node' | grep -v grep | sed -n '1,20p'
    else
        say ""
        say "系统里没有 ps（越狱机默认不带 procps）。"
        say "  看全部进程：apt install procps 之后再来"
        say "  或者用 App：菜单 → 内核 → 进程列表（原生枚举，不依赖 ps）"
    fi
    return 0
}

cmd_start() {
    if is_running; then
        say "内核已在运行（端口 $(port)）"
        return 0
    fi

    logline "start"
    # 1) 已注册：kickstart 最干净
    if launchd_loaded; then
        launchctl kickstart "system/$LABEL" 2>/dev/null && { say "已启动（launchd）"; return 0; }
    fi
    # 2) 未注册：bootstrap
    if [ -f "$PLIST" ]; then
        launchctl bootstrap system "$PLIST" 2>/dev/null \
            || launchctl load -w "$PLIST" 2>/dev/null
        if launchd_loaded; then
            say "已启动（launchd bootstrap）"
            return 0
        fi
    fi
    # 3) launchd 不可用：直接后台起
    if [ -x "$JB/usr/bin/dsh" ]; then
        mkdir -p "$ROOT/logs"
        (nohup "$JB/usr/bin/dsh" web --no-open --port "$(port)" >>"$ROOT/logs/web.log" 2>&1 &)
        sleep 2
        if is_running; then
            say "已启动（后台进程，无 launchd 守护）"
            return 0
        fi
    fi
    say "启动失败，看日志：$ROOT/logs/web.log" >&2
    return 1
}

cmd_stop() {
    logline "stop"
    # 先关保活，否则 launchd 会立刻拉起
    if [ ! -f "$FLAG" ]; then
        mkdir -p "$(dirname "$FLAG")"
        : >"$FLAG"
        say "已关闭保活"
    fi
    launchctl disable "system/$LABEL" 2>/dev/null || true

    if launchd_loaded; then
        launchctl bootout "system/$LABEL" 2>/dev/null || \
            launchctl unload "$PLIST" 2>/dev/null || true
        say "已停止（launchd 已卸载）"
    fi

    # 兜底：杀掉残留进程
    #
    # 这里不能用 "$D/node_modules/..." 这种绝对路径做模式 ——
    # 内核可能是 App 用 posix_spawn 起的，也可能是 /var/jb/usr/bin/dsh
    # 经 preboot 符号链接解析后执行的，argv 里的路径和 $D 不一致，
    # 旧模式匹配不到，于是「停不掉」。改用与路径无关的子串。
    kill_kernels

    wait_port_free || return 1
    say "内核已停止"
    return 0
}

# 杀干净「本移植版」的内核进程（不管是谁起的：launchd 还是 App posix_spawn）
# 不碰设备上别的 dsh 安装。
# dsh-ctl 只能用 date / nc / pkill / sed，不要引入 fuser / lsof / pgrep。
kill_kernels() {
    # 1) 优先用 pidfile（launcher 写入，最准）
    if [ -f "$PIDFILE" ]; then
        _p=$(sed -n '1p' "$PIDFILE" 2>/dev/null)
        case "$_p" in
            ''|*[!0-9]*) ;;
            *) kill "$_p" 2>/dev/null || true ;;
        esac
    fi

    # 2) 按 argv 扫本移植版的内核。
    #    用完整安装路径做模式，而不是 'dsh/lib/bin.js'：
    #    后者会命中设备上任何 dsh（npm 全局装的、别的越狱包），
    #    我们要停的只是自己这一份。
    pkill -f "$KERNEL_ARGV" 2>/dev/null || true

    # 3) 连 launcher 外壳一起收掉，避免它把子进程重新拉起
    pkill -f "$LAUNCHER_ARGV" 2>/dev/null || true

    rm -f "$PIDFILE" 2>/dev/null || true
}

# 等端口真正释放；先 TERM 再 KILL，最多约 6 秒
wait_port_free() {
    _i=0
    while [ "$_i" -lt 3 ]; do
        is_running || return 0
        # 还没退：升级到 SIGKILL 再扫一遍
        pkill -9 -f "$KERNEL_ARGV" 2>/dev/null || true
        pkill -9 -f "$LAUNCHER_ARGV" 2>/dev/null || true
        sleep 1
        _i=$((_i + 1))
    done
    if is_running; then
        say "⚠ 端口 $(port) 仍在监听，可能有其它实例" >&2
        say "  可执行 dsh-ctl status 查看，或用 Sileo 重启设备" >&2
        return 1
    fi
    return 0
}

# 强制清除：比 stop 更彻底，且明确「不要保活」。
# 用于「更新版本后旧内核还占着端口」或「App 里点清除进程」。
# 与 restart 的区别：restart 会恢复原来的保活状态，clear 不会。
cmd_clear() {
    logline "clear"
    cmd_stop
    RC=$?
    rm -f "$PIDFILE" 2>/dev/null || true
    if [ "$RC" -ne 0 ]; then
        return "$RC"
    fi
    say "保活已关闭，内核进程已清除。"
    return 0
}

cmd_restart() {
    logline "restart"
    was_disabled=0
    [ -f "$FLAG" ] && was_disabled=1

    cmd_stop >/dev/null 2>&1 || true

    # 重启不应改变保活设置：如果原来是开启的，恢复
    if [ "$was_disabled" -eq 0 ]; then
        rm -f "$FLAG" 2>/dev/null || true
        launchctl enable "system/$LABEL" 2>/dev/null || true
    fi

    cmd_start
}

cmd_enable() {
    logline "enable"
    rm -f "$FLAG" 2>/dev/null || true
    launchctl enable "system/$LABEL" 2>/dev/null || true
    say "保活已开启：开机自启 + 崩溃自动拉起"

    # 若当前没跑，顺手拉起来
    if ! is_running; then
        cmd_start
    fi
    return 0
}

cmd_disable() {
    logline "disable"
    mkdir -p "$(dirname "$FLAG")"
    : >"$FLAG"
    launchctl disable "system/$LABEL" 2>/dev/null || true
    say "保活已关闭：崩溃后不会自动拉起，但仍可手动 dsh-ctl start"
    say "（当前内核未停止；如需停止用 dsh-ctl stop）"
    return 0
}

BFLAG="$ROOT/config/browser-agent.disabled"
BENABLED="$ROOT/config/browser-agent.enabled"

cmd_browser() {
    sub="${2:-status}"
    case "$sub" in
        on)
            rm -f "$BFLAG"
            mkdir -p "$(dirname "$BENABLED")"
            : >"$BENABLED"
            logline "browser on"
            say "agent 浏览器权限已开启"
            say "可用工具：browser_open / snapshot / click / type / screenshot / eval"
            say "（需重启内核生效：dsh-ctl restart）"
            ;;
        off)
            rm -f "$BENABLED"
            mkdir -p "$(dirname "$BFLAG")"
            : >"$BFLAG"
            logline "browser off"
            say "agent 浏览器权限已关闭"
            say "（需重启内核生效：dsh-ctl restart）"
            ;;
        status|*)
            if [ -f "$BENABLED" ]; then
                say "agent 浏览器：已开启"
            else
                say "agent 浏览器：已关闭（默认）"
                say "  开启：dsh-ctl browser on"
            fi
            ;;
    esac
}

case "${1:-status}" in
    status)  cmd_status ;;
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    clear)   cmd_clear ;;
    ps)      cmd_ps ;;
    restart) cmd_restart ;;
    enable)  cmd_enable ;;
    disable) cmd_disable ;;
    browser) cmd_browser "$@" ;;
    *)
        say "用法: dsh-ctl {status|start|stop|clear|restart|enable|disable|browser [on|off|status]}" >&2
        exit 2
        ;;
esac

#!/bin/sh
# dsh —— DeepSeek Harness 入口（rootless /var/jb）
#
# 关键：必须带 --expose-internals。
# node-addon-require-builtin 的纯 JS shim 靠它 require() Node 私有内部模块
# （internal/modules/*），没有这个参数 dsh-app-boot 会在 host preparation 阶段抛错。
set -e

JB=/var/jb
D="$JB/usr/lib/dsh"
NODE="${DSH_NODE:-$D/bin/node}"
BIN="$D/node_modules/@deepseek-ai/dsh/lib/bin.js"
ENVF="$JB/etc/dsh/dsh.env"

[ -f "$ENVF" ] && . "$ENVF"

# 越狱态门禁：/var/jb 是符号链接，重启后 target 可能消失
if [ ! -L "$JB" ] && [ ! -d "$JB" ]; then
    echo "dsh: /var/jb 不存在，越狱未激活。" >&2
    echo "     请打开 Dopamine 点一次 Jailbreak，再回来重试。" >&2
    exit 78
fi

[ -x "$NODE" ] || { echo "dsh: node 运行时缺失：$NODE" >&2; exit 69; }
[ -f "$BIN" ]  || { echo "dsh: dsh 主程序缺失：$BIN" >&2; exit 69; }

export HOME="${HOME:-/var/mobile}"
export PATH="$JB/usr/bin:$JB/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export NODE_PATH="$D/node_modules"
export DSH_NODE="$NODE"

# ---- 数据目录：统一放在 Media 下，卸载不丢，Finder/iTunes 可见 ----
# /var/mobile/Media/deepseek-harness/
#   ├── workspaces/   工作区（用户新建目录都在这）
#   ├── config/       配置
#   ├── data/         会话 / 附件 / 存储
#   ├── cache/        pnpm / npm / tmp（可清理）
#   └── logs/         日志
DSH_ROOT="${DSH_ROOT:-/var/mobile/Media/deepseek-harness}"
export DSH_ROOT
export DSH_HOME="${DSH_HOME:-$DSH_ROOT/data}"
export DSH_CONFIG_DIR="${DSH_CONFIG_DIR:-$DSH_ROOT/config}"
export DSH_WORKSPACES_DIR="${DSH_WORKSPACES_DIR:-$DSH_ROOT/workspaces}"
export DSH_LOG_DIR="${DSH_LOG_DIR:-$DSH_ROOT/logs}"
export DSH_CACHE_DIR="${DSH_CACHE_DIR:-$DSH_ROOT/cache}"

# 内核 PID 记录：dsh-ctl 靠它精确杀进程。
# 光靠 pkill -f 匹配 argv 不可靠（App posix_spawn 起的、preboot 解析后的路径都可能不同）。
PIDFILE="$DSH_ROOT/config/kernel.pid"
export PIDFILE

for _d in "$DSH_HOME" "$DSH_CONFIG_DIR" "$DSH_WORKSPACES_DIR" "$DSH_LOG_DIR" "$DSH_CACHE_DIR"; do
    mkdir -p "$_d" 2>/dev/null || true
done

# 配置文件：优先用 config/ 下的，兼容旧位置
[ -f "$ENVF" ] || ENVF="$DSH_CONFIG_DIR/dsh.env"

# pnpm / npm 全部落到 cache/，避免写 root 属主目录导致 EACCES
PNPM_HOME="$DSH_CACHE_DIR/pnpm";                  export PNPM_HOME
XDG_DATA_HOME="$DSH_CACHE_DIR/pnpm-data";         export XDG_DATA_HOME
XDG_CACHE_HOME="$DSH_CACHE_DIR/pnpm-cache";       export XDG_CACHE_HOME
npm_config_cache="$DSH_CACHE_DIR/npm-cache";      export npm_config_cache
npm_config_store_dir="$DSH_CACHE_DIR/pnpm/store"; export npm_config_store_dir
for _d in "$PNPM_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$npm_config_cache"; do
    mkdir -p "$_d" 2>/dev/null || true
done

# TMPDIR 也放到 Media 下，避免 iOS 清理系统 tmp 导致运行时文件消失
export TMPDIR="$DSH_CACHE_DIR/tmp"
mkdir -p "$TMPDIR" 2>/dev/null || true

# 图片 shim：iOS 无 sharp，用纯 JS 头解析层替代。
# 不加这个，老对话一发送就会因 prepareImages() 遍历历史图片而抛
# LlmError("DeepSeek Messages transport failed","TRANSPORT")，前端 5/5 重试全失败。
IMG_SHIM="$D/ios-image-shim.mjs"
if [ -f "$IMG_SHIM" ]; then
    DSH_NODE_FLAGS="$DSH_NODE_FLAGS --import $IMG_SHIM"
fi

# 无参数 = 起 web profile，不开浏览器（iOS 无 xdg-open）
if [ "$#" -eq 0 ]; then
    set -- web --no-open --port "${DSH_WEB_PORT:-3080}"
fi

# ---- V8 启动档位自动探测 ----
# iOS 的 pthread_jit_write_protect_np 是按线程生效的，V8 在后台线程编译
# WASM（内置 undici 的 llhttp）时会写可执行页 → SIGBUS（zsh: bus error）。
# 各机型/系统可用的档位不同，所以让设备自己试：跑 smoke.js 逐档探测，
# 选第一个能过的，缓存到 $DSH_ROOT/.tier。
if [ -f "$D/tier.sh" ]; then
    . "$D/tier.sh"
    if ! tier_select; then
        echo "dsh: 所有 V8 启动档位都失败了。" >&2
        echo "     node = $NODE" >&2
        echo "     强制零 JIT 档试试： DSH_TIER=nowasm dsh" >&2
        exit 74
    fi
    if [ "$TIER_SOURCE" = "probed" ]; then
        printf 'dsh: 已选定启动档位 [%s]\n' "$TIER_NAME" >&2
    fi
    # 启动很慢（iOS 上 20-60 秒），给用户进度提示，否则看起来像卡死
    printf 'dsh: 正在启动（iOS 上首次启动需 20-60 秒，请耐心等待）…\n' >&2
else
    TIER_NAME="native"; TIER_ARGS=""; TIER_SQLITE_ARGS=""
fi

# 拼最终参数：档位参数 + sqlite + expose-internals
# 注意 $TIER_ARGS 故意不加引号 —— 需要拆成多个 argv
run_dsh() {
    # shellcheck disable=SC2086
    "$NODE" $TIER_ARGS $TIER_SQLITE_ARGS $DSH_NODE_FLAGS --expose-internals "$BIN" "$@"
}

# 起 web 时：输出同时进终端和日志。
# 之前直接 >>log 2>&1，终端什么都看不到，用户以为卡住了。
# 用 tee 会破坏信号传递，所以这里用「重定向 + 后台 tail 回显」。
case "$1" in
    web)
        mkdir -p "$DSH_LOG_DIR" 2>/dev/null || true
        LOG="$DSH_LOG_DIR/web.log"
        : >"$LOG" 2>/dev/null || true

        # dsh 自己会打印带 token 的 URL，直接 exec 即可。
        #
        # 之前那套「后台跑 + 前台轮询 nc 端口」是错的：
        #   - nc 在 iOS 上可能不存在，每次调用都可能长时间阻塞
        #   - while kill -0 + wait 的组合会一直阻塞到 dsh 退出
        #   - 端口检测用 DSH_WEB_PORT，与实际 argv 里的 --port 可能不一致
        #
        # 不用 tee（PIPESTATUS 是 bash 专有，本脚本是 #!/bin/sh）。
        # 改用：后台写日志 + 前台 tail -f 回显，退出码从 wait 拿。
        "$NODE" $TIER_ARGS $TIER_SQLITE_ARGS $DSH_NODE_FLAGS \
             --expose-internals "$BIN" "$@" >>"$LOG" 2>&1 &
        DSHPID=$!
        printf '%s\n' "$DSHPID" >"$PIDFILE" 2>/dev/null || true

        # tail 回显（dsh 退出时 tail 会因 SIGPIPE 自动结束）
        tail -n +1 -f "$LOG" 2>/dev/null &
        TAILPID=$!

        wait "$DSHPID"
        RC=$?
        kill "$TAILPID" 2>/dev/null || true
        ;;
    *)
        run_dsh "$@"
        RC=$?
        ;;
esac

# 崩溃兜底：被 SIGBUS/SIGSEGV/SIGILL 杀死时，强制切 nowasm 重试一次
case "$RC" in
    132|133|134|135|136|138|139)
        if [ "$TIER_NAME" != "nowasm" ] && [ -f "$D/tier.sh" ]; then
            printf 'dsh: [%s] 档被信号杀死 (rc=%s)，降级到 nowasm 重试\n' "$TIER_NAME" "$RC" >&2
            printf '%s\n' "nowasm" > "$TIER_CACHE" 2>/dev/null || true
            TIER_ARGS=$(tier_args_for nowasm)
            if [ "$1" = "web" ]; then
                # 降级重试也要记 pid，否则 dsh-ctl 又只能靠 pkill 猜
                run_dsh "$@" >>"$DSH_LOG_DIR/web.log" 2>&1 &
                DSHPID=$!
                printf '%s\n' "$DSHPID" >"$PIDFILE" 2>/dev/null || true
                wait "$DSHPID"
                RC=$?
                # 把降级后的日志也回显出来
                tail -n 30 "$DSH_LOG_DIR/web.log" 2>/dev/null || true
            else
                run_dsh "$@"
                RC=$?
            fi
        fi
        ;;
esac
exit "$RC"

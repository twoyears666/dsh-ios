<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.twoyears.dsh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/dsh</string>
        <string>web</string>
        <string>--no-open</string>
        <string>--port</string>
        <string>3080</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!--
      保活策略：只在「异常退出」时拉起，正常停止不复活。
      用 SuccessfulExit=false 而不是无条件 true：
        - 崩溃 / 被信号杀死 → 拉起
        - 正常退出（exit 0，例如 dsh-ctl stop 触发）→ 不拉起
      用户彻底关闭用 dsh-ctl stop（会 bootout 卸载，根本不触发本规则）。
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>UserName</key>
    <string>mobile</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/mobile</string>
        <key>DSH_ROOT</key>
        <string>/var/mobile/Media/deepseek-harness</string>
        <key>DSH_HOME</key>
        <string>/var/mobile/Media/deepseek-harness/data</string>
        <key>DSH_WORKSPACES_DIR</key>
        <string>/var/mobile/Media/deepseek-harness/workspaces</string>
        <key>PATH</key>
        <string>/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/mobile/Media/deepseek-harness/logs/dsh-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Media/deepseek-harness/logs/dsh-daemon.err.log</string>
</dict>
</plist>

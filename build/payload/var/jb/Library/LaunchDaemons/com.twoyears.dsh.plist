<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.twoyears.dsh</string>
    <!--
      由监督脚本而不是直接由 dsh 承载：
      App 进程在真机上不允许 exec 任何外部程序（posix_spawn 一律 ENOENT），
      所以内核只能由 launchd 这边拉起。App 通过「标记文件 + 信号」控制，
      两种手段都不需要 exec。
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/dsh-supervise</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!--
      监督脚本自己就是死循环，正常情况下不会退出；
      这一条只兜「监督脚本本身崩了」的情况。
      用 SuccessfulExit=false：崩溃拉起，正常退出（bootout）不复活。
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>UserName</key>
    <string>mobile</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/mobile</string>
        <key>DSH_ROOT</key>
        <string>/var/mobile/Media/deepseek-harness</string>
        <key>DSH_HOME</key>
        <string>/var/mobile/Media/deepseek-harness/data</string>
        <key>DSH_WORKSPACES_DIR</key>
        <string>/var/mobile/Media/deepseek-harness/workspaces</string>
        <key>PATH</key>
        <string>/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/mobile/Media/deepseek-harness/logs/dsh-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Media/deepseek-harness/logs/dsh-daemon.err.log</string>
</dict>
</plist>

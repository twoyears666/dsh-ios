#!/bin/sh
# postinst —— 安装后配置 + 数据迁移
set -e

JB=/var/jb
D="$JB/usr/lib/dsh"
ROOT=/var/mobile/Media/deepseek-harness
OLD="$JB/var/mobile/.dsh"

echo ""
echo "=== DeepSeek Harness 安装 ==="

# ---------------------------------------------------------------- 1. 建目录
# 全部数据集中到 Media 下，卸载不丢，Finder/iTunes 可见
mkdir -p "$ROOT/workspaces" \
         "$ROOT/config" \
         "$ROOT/data" \
         "$ROOT/cache" \
         "$ROOT/logs"

# 注入 iOS 环境说明（dsh 会作为 user-global 指令自动加载）
# AGENTS.md 随包安装在 data/ 下；若被用户删了，从模板恢复
if [ ! -f "$ROOT/data/AGENTS.md" ] && [ -f "$D/AGENTS.md.template" ]; then
    cp "$D/AGENTS.md.template" "$ROOT/data/AGENTS.md"
    echo "  已恢复 AGENTS.md（iOS 环境说明）"
fi

# ---------------------------------------------------------------- 2. 数据迁移
# 从旧路径 $JB/var/mobile/.dsh 迁到 $ROOT
if [ -d "$OLD" ]; then
    echo "  检测到旧数据：$OLD"

    # 2.1 会话
    if [ -d "$OLD/sessions" ] && [ -n "$(ls -A "$OLD/sessions" 2>/dev/null)" ]; then
        if [ -z "$(ls -A "$ROOT/data/sessions" 2>/dev/null)" ]; then
            echo "    迁移 sessions/"
            cp -R "$OLD/sessions" "$ROOT/data/" 2>/dev/null || true
        else
            echo "    跳过 sessions/（新位置已有数据）"
        fi
    fi

    # 2.2 附件
    for d in attachments storages skills; do
        if [ -d "$OLD/$d" ] && [ -n "$(ls -A "$OLD/$d" 2>/dev/null)" ]; then
            if [ -z "$(ls -A "$ROOT/data/$d" 2>/dev/null)" ]; then
                echo "    迁移 $d/"
                cp -R "$OLD/$d" "$ROOT/data/" 2>/dev/null || true
            fi
        fi
    done

    # 2.3 配置
    for f in .credentials.yaml; do
        if [ -f "$OLD/$f" ] && [ ! -f "$ROOT/config/$f" ]; then
            echo "    迁移 $f"
            cp "$OLD/$f" "$ROOT/config/" 2>/dev/null || true
        fi
    done

    # 2.4 profiles（含 cordis.patch.yml）
    if [ -d "$OLD/profiles" ]; then
        if [ ! -d "$ROOT/config/profiles" ]; then
            echo "    迁移 profiles/"
            cp -R "$OLD/profiles" "$ROOT/config/" 2>/dev/null || true
        fi
    fi

    # 2.5 旧日志
    for f in web.log dsh-daemon.log dsh-daemon.err.log; do
        [ -f "$OLD/$f" ] && cp "$OLD/$f" "$ROOT/logs/$f.migrated" 2>/dev/null || true
    done

    echo "  迁移完成（旧目录保留在 $OLD，确认无误后可手动删除）"
fi

# ---------------------------------------------------------------- 3. 属主
# mobile = uid 501。Media 目录下必须可写，否则 dsh 建不了会话
chown -R 501:501 "$ROOT" 2>/dev/null || true
chmod 755 "$ROOT" 2>/dev/null || true
for sub in workspaces config data cache logs; do
    chmod 755 "$ROOT/$sub" 2>/dev/null || true
done

# node 可执行
[ -f "$D/bin/node" ] && chmod 755 "$D/bin/node"

# ---------------------------------------------------------------- 4. 原生 App
APP="$JB/Applications/DSH.app"
if [ -d "$APP" ]; then
    chmod 755 "$APP/DSH" 2>/dev/null || true
    # App 必须带 no-sandbox / platform-application 才能执行 launchctl 和 dsh
    if command -v ldid >/dev/null 2>&1; then
        if [ -f "$APP/entitlements.plist" ]; then
            ldid -S"$APP/entitlements.plist" "$APP/DSH" 2>/dev/null \
                && echo "  App 已伪签（含 no-sandbox）" \
                || echo "  ⚠ App 伪签失败"
        elif [ -f "$D/entitlements.plist" ]; then
            ldid -S"$D/entitlements.plist" "$APP/DSH" 2>/dev/null || true
        fi
    else
        echo "  ⚠ 无 ldid，App 无法执行外部进程（需手动补签）"
    fi
    chown -R 501:501 "$APP" 2>/dev/null || true
    command -v uicache >/dev/null 2>&1 && uicache -p "$APP" 2>/dev/null || true
fi

# ---------------------------------------------------------------- 5. launchd
PLIST="$JB/Library/LaunchDaemons/com.twoyears.dsh.plist"

# 5.1 先杀干净旧内核
#
# 只 bootout 是不够的：bootout 只收掉 launchd 自己监督的那个进程。
# 如果旧内核是 App 通过 posix_spawn 起的（POSIX_SPAWN_SETSID 已经脱离
# 进程组），它根本不归 launchd 管，bootout 之后照样占着 3080 端口。
# 新 App 起来后探测端口发现「已通」就直接复用 —— 于是跑的还是旧版本，
# 表现就是「更新了但没生效、日志也不刷新」。
#
# 所以这里必须按 argv 兜底扫一遍。
#
# 只扫「我们自己这一份」：模式用完整安装路径，
# 不用 'dsh/lib/bin.js' 这种宽子串 —— 设备上可能还装着
# npm 全局的 dsh 或别的越狱包，升级我们不应该把它们杀掉。
export PATH="$JB/usr/bin:$JB/bin:/usr/bin:/bin:/usr/sbin:/sbin"
KERNEL_ARGV="$D/node_modules/@deepseek-ai/dsh/lib/bin.js"
if [ -x "$JB/usr/bin/dsh-ctl" ]; then
    "$JB/usr/bin/dsh-ctl" clear >/dev/null 2>&1 || true
else
    pkill -f "$KERNEL_ARGV" 2>/dev/null || true
    pkill -f "$JB/usr/bin/dsh web" 2>/dev/null || true
    sleep 1
    pkill -9 -f "$KERNEL_ARGV" 2>/dev/null || true
    pkill -9 -f "$JB/usr/bin/dsh web" 2>/dev/null || true
fi
rm -f "$ROOT/config/kernel.pid" 2>/dev/null || true

# 5.2 版本戳：让 App / dsh-ctl 能看出当前装的是哪个版本
if [ -f "$D/VERSION" ]; then
    cp "$D/VERSION" "$ROOT/config/installed.version" 2>/dev/null || true
fi

# 5.3 重新注册（clear 会把 launchd 置为 disabled，这里恢复默认自启）
#
# 真机上出现过「装完内核不跑、supervise.log 压根不存在」的情况：
# launchd 根本没接住这个 job，而失败被 || true 吞掉了，什么都没留下。
# 所以这里改成：注册 → 打印诊断 → 没起来就自己兜底拉起，全程写 install.log。
INSTALL_LOG="$ROOT/logs/install.log"
mkdir -p "$ROOT/logs" 2>/dev/null || true

install_diag() {
    {
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') $1 ==="
        echo "--- plist ---"
        ls -l "$PLIST" 2>&1
        plutil -lint "$PLIST" 2>&1
        echo "--- launchctl print system/$LABEL ---"
        launchctl print "system/$LABEL" 2>&1 | head -25
        echo "--- disabled 覆盖 ---"
        launchctl print-disabled system 2>&1 | grep -i "$LABEL" 2>&1
        echo "--- 端口 3080 ---"
        if nc -z 127.0.0.1 3080 2>/dev/null; then echo "在监听"; else echo "未监听"; fi
        echo "--- supervise.log 尾部 ---"
        tail -15 "$ROOT/logs/supervise.log" 2>&1
        echo
    } >>"$INSTALL_LOG" 2>&1
}

if [ -f "$PLIST" ]; then
    launchctl enable "system/$LABEL" 2>/dev/null || true
    rm -f "$ROOT/config/keepalive.disabled" 2>/dev/null || true
    # 清掉「我要内核跑」以外的历史状态；want 由 App 自己写
    launchctl bootout "system/$LABEL" 2>/dev/null || true
    launchctl bootout system "$PLIST" 2>/dev/null || true
    sleep 1

    # 依次尝试三种注册方式，哪种成就停
    # -F 是关键：强制加载，忽略 launchd 的 disabled 覆盖表。
    # 老版本留下的 disable 记录只能靠它绕过（bootstrap 会被直接拒）。
    launchctl bootstrap system "$PLIST" 2>>"$INSTALL_LOG" \
        || launchctl load -w -F "$PLIST" 2>>"$INSTALL_LOG" \
        || launchctl load -w "$PLIST" 2>>"$INSTALL_LOG" \
        || launchctl kickstart "system/$LABEL" 2>>"$INSTALL_LOG" \
        || true
    sleep 3

    install_diag "注册完成"

    # 兜底：launchd 没接住就自己拉起来。虽然是 root 起的一次性进程，
    # 但至少内核能用；下次重启再由 launchd 接管。
    if ! nc -z 127.0.0.1 3080 2>/dev/null; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') launchd 未拉起内核，postinst 直接启动监督进程" \
            >>"$INSTALL_LOG"
        (nohup "$JB/usr/bin/dsh-supervise" >>"$ROOT/logs/supervise.log" 2>&1 &) 2>/dev/null || true
        sleep 4
        install_diag "兜底启动后"
    fi
fi

# ---------------------------------------------------------------- 6. 提示
echo ""
echo "数据目录: $ROOT"
echo "  工作区: $ROOT/workspaces   ← 新建的项目放这里"
echo "  配置:   $ROOT/config"
echo "  日志:   $ROOT/logs"
echo ""
echo "  URL:    dsh-url"
echo "  自检:   dsh-doctor"
echo ""
exit 0
